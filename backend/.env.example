# ==============================================================================
# AI Resume & Job Matcher - Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit production secrets or real passwords to version control.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# Frontend Client URL / Allowed CORS Origins
# Comma-separated list of allowed web domains (e.g. your Vercel or custom domain)
CLIENT_URL=https://your-frontend-domain.vercel.app,http://localhost:3000

# ------------------------------------------------------------------------------
# Hosted MySQL Database Configuration
# Option A: Single Connection URI (Provided by Render, Railway, TiDB Cloud, etc.)
# DATABASE_URL=mysql://username:password@host:3306/database_name?ssl={"rejectUnauthorized":true}

# Option B: Discrete Parameters (Aiven, AWS RDS, DigitalOcean, self-hosted)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_secure_mysql_password
DB_NAME=resume_job_matcher

# SSL Configuration for Cloud Databases (Aiven, TiDB, AWS RDS require SSL)
# Set to true for cloud hosting providers
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional base64 or path to CA certificate if required by provider (e.g. Aiven)
# DB_CA_CERT=

# Connection Pool Size (default: 10)
DB_CONNECTION_LIMIT=10

# ------------------------------------------------------------------------------
# Authentication (JWT)
# Generate a cryptographically random string (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (for OpenID Connect Token Verification)
# Must match the Client ID configured on the frontend (VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# AI & Semantic Embeddings Provider Credentials
# Google Gemini API key used for resume-to-job semantic embeddings and suggestions
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Persistent Storage Configuration
# Resumes must be kept privately and persist across container/service redeployments.
# On Render: Attach a Persistent Disk (e.g., Mount Path: /var/data/uploads)
# On Railway: Mount a persistent volume at /app/uploads or /data/uploads
UPLOADS_DIR=/var/data/uploads
